{
  "name": "siliconbob-hardware-ide",
  "displayName": "SiliconBob: Universal Code Checker & Optimizer",
  "description": "Universal multi-language AI code checker, bug hunter, anti-pattern detector, and automated refactor optimizer for IBM Bob (Python, C/C++, JS/TS, Java, Go, Rust, Verilog/RTL).",
  "version": "1.0.0",
  "publisher": "siliconbob-team",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:java",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:verilog",
    "onLanguage:systemverilog",
    "onCommand:siliconbob.optimizeCode",
    "onCommand:siliconbob.optimizeRTL",
    "onCommand:siliconbob.connectWorkspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "siliconbob.optimizeCode",
        "title": "Analyze & Optimize Code (All Languages)",
        "category": "SiliconBob"
      },
      {
        "command": "siliconbob.optimizeRTL",
        "title": "Hardware RTL Optimizer (Verilog/SystemVerilog)",
        "category": "SiliconBob"
      },
      {
        "command": "siliconbob.connectWorkspace",
        "title": "Join Multi-Engineer Room",
        "category": "SiliconBob"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorTextFocus",
          "command": "siliconbob.optimizeCode",
          "group": "SiliconBob@1"
        },
        {
          "when": "editorTextFocus",
          "command": "siliconbob.connectWorkspace",
          "group": "SiliconBob@2"
        }
      ]
    },
    "configuration": {
      "title": "SiliconBob",
      "properties": {
        "siliconbob.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of the SiliconBob hardware optimization backend server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "@bytesized/shared": "file:../shared"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
