{
  "name": "siliconbob-hardware-ide",
  "displayName": "SiliconBob: Electronic Chip Design Copilot",
  "description": "Collaborative RTL hardware optimization, inadvertent latch fixer, and PPA enhancer for IBM Bob",
  "version": "1.0.0",
  "publisher": "siliconbob-team",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:verilog",
    "onLanguage:systemverilog",
    "onCommand:siliconbob.optimizeRTL",
    "onCommand:siliconbob.connectWorkspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "siliconbob.optimizeRTL",
        "title": "SiliconBob: Analyze & Optimize RTL",
        "category": "SiliconBob"
      },
      {
        "command": "siliconbob.connectWorkspace",
        "title": "SiliconBob: Join Multi-Engineer Hardware Room",
        "category": "SiliconBob"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceExtname == .v || resourceExtname == .sv",
          "command": "siliconbob.optimizeRTL",
          "group": "SiliconBob@1"
        },
        {
          "when": "resourceExtname == .v || resourceExtname == .sv",
          "command": "siliconbob.connectWorkspace",
          "group": "SiliconBob@2"
        }
      ]
    },
    "configuration": {
      "title": "SiliconBob",
      "properties": {
        "siliconbob.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of the SiliconBob hardware optimization backend server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "@bytesized/shared": "file:../shared"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
