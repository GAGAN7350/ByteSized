{
  "name": "blueprintbob",
  "displayName": "BlueprintBob: Architecture & Codebase Visualizer",
  "description": "Interactive AI architecture diagrams and codebase maps for IBM Bob IDE / VS Code",
  "version": "0.1.0",
  "publisher": "bytesized-team",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:blueprintbob.visualizeWorkspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "blueprintbob.visualizeWorkspace",
        "title": "BlueprintBob: Visualize Workspace Architecture",
        "category": "BlueprintBob"
      }
    ],
    "configuration": {
      "title": "BlueprintBob",
      "properties": {
        "blueprintbob.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of the BlueprintBob / ByteSized backend server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "@bytesized/shared": "file:../shared"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
