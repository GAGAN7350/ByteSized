{
  "name": "bytesized-code-optimizer",
  "displayName": "ByteSized: Universal Code Checker & Optimizer",
  "description": "Multi-language code quality analyzer, bug fixer, and AI performance optimizer for IBM Bob IDE",
  "version": "1.0.0",
  "publisher": "bytesized-team",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onCommand:bytesized.optimizeCode",
    "onCommand:bytesized.joinRoom"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bytesized.optimizeCode",
        "title": "ByteSized: Check & Optimize Code",
        "category": "ByteSized"
      },
      {
        "command": "bytesized.joinRoom",
        "title": "ByteSized: Join Collaborative Room",
        "category": "ByteSized"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorTextFocus",
          "command": "bytesized.optimizeCode",
          "group": "ByteSized@1"
        }
      ]
    },
    "configuration": {
      "title": "ByteSized Code Optimizer",
      "properties": {
        "bytesized.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of the ByteSized AI Backend server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
