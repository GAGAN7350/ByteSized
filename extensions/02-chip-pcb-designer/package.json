{
  "name": "bytesized-pcb-chip-designer",
  "displayName": "ByteSized: Microchip & PCB Visual Designer",
  "description": "Interactive microchip block layout, IC pinout, and PCB circuit schematic designer inside IBM Bob IDE",
  "version": "1.0.0",
  "publisher": "bytesized-team",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:bytesized.openCircuitDesigner"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bytesized.openCircuitDesigner",
        "title": "ByteSized: Open Microchip & PCB Visual Designer",
        "category": "ByteSized"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "bytesized.openCircuitDesigner"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
