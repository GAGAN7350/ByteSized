{
  "name": "bytesized-git-diagram",
  "displayName": "ByteSized: Git Architecture & Flow Diagram",
  "description": "Visual Git commit topology, branch flow, and repository architecture diagram visualizer for IBM Bob IDE",
  "version": "1.0.0",
  "publisher": "bytesized-team",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "SCM Providers"
  ],
  "activationEvents": [
    "onCommand:bytesized.generateGitDiagram"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bytesized.generateGitDiagram",
        "title": "ByteSized: View Git Flow & Architecture Diagram",
        "category": "ByteSized"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "bytesized.generateGitDiagram"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
